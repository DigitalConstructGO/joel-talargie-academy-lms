{
  "name": "@joel-academy/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx scripts/db-command.ts migrate",
    "db:seed": "tsx scripts/db-command.ts seed",
    "db:seed:performance": "tsx scripts/performance-seed.ts",
    "db:export": "tsx scripts/export-db.ts",
    "db:check": "tsx scripts/db-command.ts check"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.20.3",
    "dotenv": "^17.4.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  }
}
