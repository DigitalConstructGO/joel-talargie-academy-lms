NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# 'live' calls the real NestJS backend; 'mock' (the default when unset) uses the bundled demo dataset.
NEXT_PUBLIC_CATALOG_DATA_SOURCE=live
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public site origin used for sitemap.xml, robots.txt, canonical/OG URLs, and JSON-LD. Set to the real production domain before deploying.
NEXT_PUBLIC_SITE_URL=
