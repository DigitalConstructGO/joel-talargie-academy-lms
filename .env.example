# ==============================================================================
# JOEL TALARGIE ACADEMY LMS — ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env for local development or .env.production / .env.hostinger for deployment.
# ==============================================================================

# Application Environment & Server Ports
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ADDITIONAL_ORIGINS=
TRUST_PROXY=false
BODY_LIMIT=1mb

# Security, Cryptography & Authentication Secrets
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_COOKIE_SECURE=false
BCRYPT_SALT_ROUNDS=12

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST.neon.tech/neondb?sslmode=require
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require
DATABASE_TEST_URL=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Mail / SMTP Configuration
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Joel Talargie Academy
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_REPLY_TO=your-email@gmail.com
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_WORKER_ENABLED=false
EMAIL_PUBLIC_APP_URL=http://localhost:3000

# File Storage Configuration (Local or S3)
STORAGE_DRIVER=local
STORAGE_ROOT=
STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-characters-for-storage-tokens
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Certificates & Verification
CERTIFICATE_PUBLIC_BASE_URL=http://localhost:3000/certificates/verify
CERTIFICATE_VERIFICATION_URL=http://localhost:3000/certificates/verify
CERTIFICATE_GENERATION_ENABLED=true
CERTIFICATE_WORKER_ENABLED=false
CERTIFICATE_WORKER_POLL_MS=5000
CERTIFICATE_WORKER_BATCH_SIZE=2
CERTIFICATE_JOB_LOCK_TIMEOUT_MS=300000
CERTIFICATE_JOB_MAX_ATTEMPTS=5

# Geez SMS Configuration
SMS_ENABLED=false
SMS_PROVIDER=geez
GEEZ_SMS_TOKEN=your-geez-sms-api-token
GEEZ_SMS_SHORTCODE_ID=
GEEZ_SMS_CALLBACK_URL=http://localhost:4000/api/v1/sms/callback
SMS_WORKER_ENABLED=false
SMS_WORKER_POLL_MS=5000
SMS_WORKER_BATCH_SIZE=10

# Google Gemini AI Assistant Configuration
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_CHAT_RATE_LIMIT=10
AI_CHAT_RATE_TTL_MS=900000

# Telegram Bot Integration Configuration
TELEGRAM_ENABLED=true
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=Joel_Talargie_Academy_Bot
TELEGRAM_WEBHOOK_URL=http://localhost:4000/api/v1/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Admin Controls & Report Export
PAYMENT_RECEIPT_MAX_SIZE_MB=10
REPORT_EXPORTS_ENABLED=true
REPORT_EXPORT_MAX_ROWS=100000
REPORT_EXPORT_RETENTION_DAYS=30
